{
  "name": "dizimo-client-local",
  "version": "2.1.0",
  "description": "Módulo local Windows para integração com impressora térmica e PINPad (multi-provedor: Connect TEF, Sipag, Pagar.me Stone, PayGo)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "package": "pkg dist/index.js --targets node20-win-x64 --output dist/DizimoSC-Client.exe",
    "install-service": "node scripts/install-service.js",
    "uninstall-service": "node scripts/uninstall-service.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "zod": "^3.25.0",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "escpos-serialport": "^3.0.0-alpha.4",
    "escpos-network": "^3.0.0-alpha.4",
    "serialport": "^12.0.0",
    "usb": "^2.14.0",
    "winston": "^3.14.0",
    "winston-daily-rotate-file": "^5.0.0",
    "node-windows": "^1.0.0-beta.8",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "pkg": "^5.8.1"
  }
}
